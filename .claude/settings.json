{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(playwright-cli *)",
      "PowerShell(playwright-cli *)"
    ],
    "ask": [
      "Bash(playwright-cli *run-code*)",
      "Bash(playwright-cli *eval*)",
      "PowerShell(playwright-cli *run-code*)",
      "PowerShell(playwright-cli *eval*)",
      "Bash(npm *)",
      "Bash(npx *)",
      "PowerShell(npm *)",
      "PowerShell(npx *)"
    ]
  }
}
